# Disabled until isolated project, indexes and native app have been verified.
PUSH_ENABLED=false
APP_ENV=development
FCM_ENVIRONMENT=development
FCM_PROJECT_ID=
# Required in non-production; sending to this project is rejected outside production.
FCM_PRODUCTION_PROJECT_ID=
# Non-production recipients: comma-separated test customer Mongo IDs only.
PUSH_TEST_USER_IDS=
# 32+ random characters, server-only; binds audience preview confirmation.
PUSH_CONFIRMATION_SECRET=
# Use workload identity/ADC or a mounted server-only service account file.
GOOGLE_APPLICATION_CREDENTIALS=
# Used only by the additive index installer.
PUSH_MIGRATION_MONGODB_URI=
